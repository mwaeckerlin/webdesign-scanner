{
  "name": "@mwaeckerlin/webdesign-scanner",
  "version": "1.0.3",
  "description": "Render a website in many viewports and print formats and produce evidence for an AI design review",
  "type": "module",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "docker compose build",
    "start": "docker compose up --build --exit-code-from scanner scanner",
    "start:daemon": "docker compose up -d --build scanner",
    "start:dev": "docker compose up --build --exit-code-from scanner scanner",
    "stop": "docker compose down -v --remove-orphans",
    "deploy": "docker compose push",
    "compile": "tsc -p tsconfig.json",
    "results": "docker compose cp scanner:/out ./out",
    "build:overview": "python3 doc/build-overview.py",
    "test": "npm run test:docs && npm run test:unit && npm run test:image && npm run test:e2e",
    "test:docs": "bash tests/docs-contract.sh",
    "test:unit": "tsc -p tsconfig.test.json && vitest run",
    "test:image": "npm run build && bash tests/image-contract.sh mwaeckerlin/webdesign-scanner",
    "test:e2e": "bash tests/run-e2e.sh"
  },
  "dependencies": {
    "playwright": "1.61.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
